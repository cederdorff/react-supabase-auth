# Kopiér filen til .env, og indsæt værdierne fra dit Supabase-projekt.
# Det er de samme værdier, som står i chatbottens frontend/.env.
#
# Find dem i Supabase under Project Settings → API Keys.
# Står der en "publishable key" (sb_publishable_...) i stedet for en anon key,
# så brug den. Den virker på samme måde.
#
# Brug aldrig service role key / secret key her. Alt med VITE_ ender i browseren.

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
